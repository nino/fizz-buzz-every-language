$ include "seed7_05.s7i";

const proc: main is func
  local
    var integer: i is 0;
  begin
    for i range 1 to 100 do
      if i rem 15 = 0 then
        writeln("FizzBuzz");
      elsif i rem 3 = 0 then
        writeln("Fizz");
      elsif i rem 5 = 0 then
        writeln("Buzz");
      else
        writeln(i);
      end if;
    end for;
  end func;
