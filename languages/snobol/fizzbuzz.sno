*       FizzBuzz in SNOBOL4
        I = 1
LOOP    GT(I, 100)                                      :S(END)
        EQ(REMDR(I, 15), 0)                             :S(FB)
        EQ(REMDR(I, 3), 0)                              :S(FZ)
        EQ(REMDR(I, 5), 0)                              :S(BZ)
        OUTPUT = I                                      :(NEXT)
FB      OUTPUT = "FizzBuzz"                             :(NEXT)
FZ      OUTPUT = "Fizz"                                 :(NEXT)
BZ      OUTPUT = "Buzz"                                 :(NEXT)
NEXT    I = I + 1                                       :(LOOP)
END
