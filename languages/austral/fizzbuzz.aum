(* FizzBuzz in Austral *)
module body Fizzbuzz is
    function main(root: RootCapability): ExitCode is
        var i: Nat32 := 1;
        while i <= 100 do
            if (i mod 15) = 0 then
                printLn("FizzBuzz");
            else
                if (i mod 3) = 0 then
                    printLn("Fizz");
                else
                    if (i mod 5) = 0 then
                        printLn("Buzz");
                    else
                        printLn(i);
                    end if;
                end if;
            end if;
            i := i + 1;
        end while;
        surrenderRoot(root);
        return ExitSuccess();
    end;
end module body.
