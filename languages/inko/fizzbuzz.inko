# FizzBuzz in Inko
import std.stdio (Stdout)

class async Main {
  fn async main {
    let out = Stdout.new
    let mut i = 1

    while i <= 100 {
      if i % 15 == 0 {
        out.print('FizzBuzz')
      } else if i % 3 == 0 {
        out.print('Fizz')
      } else if i % 5 == 0 {
        out.print('Buzz')
      } else {
        out.print(i.to_string)
      }

      i += 1
    }
  }
}
